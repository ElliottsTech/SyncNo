{
  "name": "mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing SyncNo business data to LLMs over the existing REST API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
