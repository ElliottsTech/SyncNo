# SyncNo Environment Variables
# Copy this file to .env and fill in your values

# App
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Host install dir (absolute path on the HOST where SyncNo is cloned).
# Shown in the UI as the update.sh path. Defaults to /opt/syncno if unset.
HOST_INSTALL_DIR=/opt/syncno

# Backend
SYNCRO_API_KEY=your-syncro-api-key
SYNCRO_SUBDOMAIN=your-syncro-subdomain

# Frontend (Azure AD SSO)
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# API URL (frontend → backend)
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# MCP server (exposes SyncNo data to LLM clients over Streamable HTTP on :3003).
# Reuses SYNCNO_API_KEY to authenticate to the backend. MCP_API_TOKEN is the
# secret LLM clients must present to the MCP server — keep it separate from
# SYNCNO_API_KEY. Generate with: openssl rand -base64 32
MCP_API_TOKEN=generate-with-openssl-rand-base64-32
MCP_PORT=3003
