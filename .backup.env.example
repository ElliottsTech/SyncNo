# SyncNo backup configuration. Copy to .backup.env and fill in.
# .backup.env is gitignored — never commit secrets.
#
# Generated by following /root/SyncNo/docs/BACKUP.md.

# restic repository. rclone: prefix points at the [sharepoint] remote in rclone.conf.
export RESTIC_REPOSITORY="rclone:sharepoint:/SyncNo-Backups/syncno"

# File containing the restic repo password. Generate with:
#   openssl rand -base64 32 > /root/.restic-password
#   chmod 600 /root/.restic-password
export RESTIC_PASSWORD_FILE="/root/.restic-password"

# rclone config path (default location usually fine)
export RCLONE_CONFIG="/root/.config/rclone/rclone.conf"

# Retention: how many daily snapshots to keep
export BACKUP_KEEP_DAILY="14"

# Staging directory (must be tmpfs to avoid filling host disk)
export BACKUP_STAGE_DIR="/mnt/backup-stage"

# Optional: throttle rclone if Microsoft returns 429
# export RCLONE_TRANSFERS="4"
# export RCLONE_TPSLIMIT="10"
